{
  // There was no tsconfig.json in this project, so `npx tsc --noEmit -p .` failed with TS5057
  // and nothing type-checked the backend at all. Everything ran through tsx, which strips types
  // without reading them, so a wrong type reached production as easily as a right one.
  //
  // This config is for checking only — noEmit is set and nothing here builds. The Docker image
  // and the Vercel bundle are produced the way they always were.
  "compilerOptions": {
    // "Bundler" resolution, not "NodeNext", because tsx is what actually runs this code and it
    // resolves extensionless relative imports the way a bundler does. Checking under NodeNext
    // produced 664 TS2835 errors demanding a ".js" suffix on every relative import in the
    // project — a config mismatch reported as 664 defects, and rewriting every import to
    // satisfy it would be a large change that fixes nothing real.
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,

    // tsx permits `import "./x.ts"` and extensionless relative imports alike; this lets the
    // checker accept the same spellings rather than demanding a rewrite of every import.
    "allowImportingTsExtensions": true,

    // Deliberately not "strict". Turning every check on at once against a codebase that has
    // never been checked produces thousands of findings and gets switched off again within a
    // day. These are the ones that catch real defects on their own, and the list is meant to
    // grow: "strictNullChecks" is the next one worth the work.
    "strict": false,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "useUnknownInCatchVariables": true
  },
  "include": ["src/**/*.ts", "server.ts"],
  "exclude": [
    "node_modules",
    "dist",
    // The committed prebuilt Vercel bundle, not source.
    "api",
    // A Python virtualenv lives under src/scraping; it holds no TypeScript but walking it is
    // slow and it contains files TypeScript would try to read.
    "src/scraping/venv",
    "src/scraping/venv313"
  ]
}
